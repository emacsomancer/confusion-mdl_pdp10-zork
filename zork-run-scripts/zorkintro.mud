<DEFINE ZORK-TYPE (TEXT DELAY)
  <COND
    (<G=? <LENGTH .TEXT> 1>
     <PRINC <1 .TEXT>>
     <SLEEP-MS .DELAY>
     <ZORK-TYPE <REST .TEXT> .DELAY>)>>

<DEFINE ZORK-TYPE-FAST (TEXT)
  <ZORK-TYPE .TEXT 25>>

<DEFINE ZORK-TYPE-NORMAL (TEXT)
  <ZORK-TYPE .TEXT 60>>

<DEFINE ZORK-TYPE-SLOW (TEXT)
  <ZORK-TYPE .TEXT 120>>

<DEFINE ZORK-PRINT-LINE (TEXT)
  <PRINC .TEXT>
  <TERPRI>>

<DEFINE ZORK-TYPE-LINE (TEXT DELAY)
  <ZORK-TYPE .TEXT .DELAY>
  <TERPRI>>

<DEFINE ZORK-TYPE-LINE-MEDIUM (TEXT)
  <ZORK-TYPE .TEXT 5>
  <TERPRI>>

<DEFINE ZORK-TYPE-LINE-SLOWER (TEXT)
  <ZORK-TYPE .TEXT 60>
  <TERPRI>>

<DEFINE ZORK-PRINT-NOW (TEXT)
  <PRINC .TEXT>>

<DEFINE ZORK-INTRO ()
  <ZORK-TYPE-LINE "  CONVOLUTION MDL" 40>
  <ZORK-TYPE-LINE "  Initializing the Quendorian Muddle environment..." 45>
  <ZORK-PRINT-LINE "  Runtime services loaded.">
  <ZORK-TYPE-LINE-MEDIUM "<PSETG RMGVALS '![BLOC HERE!]">

  <ZORK-TYPE-LINE-MEDIUM "<PSETG OBJGVALS '![!]>">

  <ZORK-TYPE-LINE-MEDIUM ";\"GLOBAL VARIABLES WHICH ARE MONADS MUST BE HERE!\"">

  <ZORK-TYPE-LINE-MEDIUM "<PSETG MGVALS">
  <ZORK-TYPE-LINE-MEDIUM "      '![KITCHEN-WINDOW!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         TROLL-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         CAGE-SOLVE!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         KEY-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         BUCKET-TOP!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         CAROUSEL-FLIP!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         CAROUSEL-ZOOM!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         LOW-TIDE!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         DOME-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         GLACIER-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         ECHO-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         RIDDLE-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         LLD-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         CYCLOPS-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         MAGIC-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         TRAP-DOOR!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         LIGHT-LOAD!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         SAFE-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         GNOME-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         GNOME-DOOR!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         MIRROR-MUNG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         EGYPT-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         ON-POLE!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         BLAB!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         BINF!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         BTIE!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         BUOY-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         GRUNLOCK!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         GATE-FLAG!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         RAINBOW!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         CAGE-TOP!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         EMPTY-HANDED!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         DEFLATE!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         LIGHT-SHAFT">
  <ZORK-TYPE-LINE-MEDIUM "         PLAYED-TIME">
  <ZORK-TYPE-LINE-MEDIUM "         MOVES">
  <ZORK-TYPE-LINE-MEDIUM "         BRIEF!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         THEN">
  <ZORK-TYPE-LINE-MEDIUM "         SUPER-BRIEF!-FLAG">
  <ZORK-TYPE-LINE-MEDIUM "         RAW-SCORE!]>">

  <ZORK-TYPE-LINE-MEDIUM "<PSETG CNTUSE \"You can't use that!\">">

  <ZORK-TYPE-LINE-MEDIUM "<SETG BIGFIX </ <CHTYPE <MIN> FIX> 2>>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG WORDS <OR <GET WORDS OBLIST> <MOBLIST WORDS 23>>>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG OBJECT-OBL <OR <GET OBJECTS OBLIST> <MOBLIST OBJECTS>>>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG ROOM-OBL <OR <GET ROOMS OBLIST> <MOBLIST ROOMS>>>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG ACTORS ()>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG STARS ()>">

  <ZORK-TYPE-LINE-MEDIUM "<ADD-BUZZ \"BY\" \"IS\" \"ONE\" \"IT\" \"A\" \"THE\" \"AN\" \"THIS\""> 

  <ZORK-TYPE-LINE-MEDIUM "<ADD-DIRECTIONS \"#!#!#\" \"NORTH\" \"SOUTH\" \"EAST\" \"WEST\"">
  <ZORK-TYPE-LINE-MEDIUM "\"LAUNC\" \"LAND\"">
  <ZORK-TYPE-LINE-MEDIUM "        \"SE\" \"SW\" \"NE\" \"NW\" \"UP\" \"DOWN\" \"ENTER\" \"EXIT\" \"CROSS\" \"CLIMB\">">

  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"NORTH\" \"N\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"SOUTH\" \"S\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"EAST\" \"E\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"WEST\" \"W\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"UP\" \"U\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"DOWN\" \"D\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"ENTER\" \"IN\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"EXIT\" \"OUT\" \"LEAVE\">">
  <ZORK-TYPE-LINE-MEDIUM "<DSYNONYM \"CROSS\" \"TRAVE\">">

  <ZORK-TYPE-LINE-MEDIUM "<ADD-ZORK PREP \"WITH\" \"AT\" \"TO\" \"IN\" \"DOWN\" \"UP\" \"UNDER\"">

  <ZORK-TYPE-LINE-MEDIUM "<SYNONYM \"WITH\" \"USING\" \"THROU\">">

  <ZORK-TYPE-LINE-MEDIUM "<SYNONYM \"IN\" \"INSID\" \"INTO\">">

  <ZORK-TYPE-LINE-MEDIUM "<SETG ROOMS ()>">

  <ZORK-TYPE-LINE-MEDIUM "<SETG OBJECTS ()>">

  <ZORK-TYPE-LINE-MEDIUM " <ROOM \"WHOUS\"">
  <ZORK-TYPE-LINE-MEDIUM " \"You are in an open field west of a big white house, with a boarded">
  <ZORK-TYPE-LINE-MEDIUM " front door.\"">
  <ZORK-TYPE-LINE-MEDIUM "      \"West of House\"">
  <ZORK-TYPE-LINE-MEDIUM "      T">
  <ZORK-TYPE-LINE-MEDIUM "      <EXIT \"NORTH\" \"NHOUS\" \"SOUTH\" \"SHOUS\" \"WEST\" \"FORE1\"">
  <ZORK-TYPE-LINE-MEDIUM "               \"EAST\" #NEXIT \"The door is locked, and there is evidently no key.\">">
  <ZORK-TYPE-LINE-MEDIUM "        (<FIND-OBJ \"FDOOR\"> <FIND-OBJ \"MAILB\">)>">
  <ZORK-TYPE-LINE-MEDIUM "">
  <ZORK-TYPE-LINE-MEDIUM "<OBJECT \"#####\"">
  <ZORK-TYPE-LINE-MEDIUM "         \"You are here\" \"cretin\" %<> %<> () %<> %,OVISON>">
  <ZORK-TYPE-LINE-MEDIUM "">
  <ZORK-TYPE-LINE-MEDIUM "<ROOM MAZE1">
  <ZORK-TYPE-LINE-MEDIUM "      (IN ROOMS)">
  <ZORK-TYPE-LINE-MEDIUM "      (RDESC1 \"You are in a maze of twisty little passages, all alike.\")">
  <ZORK-TYPE-LINE-MEDIUM "      (RDESC2 \"You are in a maze of twisty little passages, all alike.\")">
  <ZORK-TYPE-LINE-MEDIUM "      (RSEEN? <>)">
  <ZORK-TYPE-LINE-MEDIUM "      (RLIGHT? <>)">
  <ZORK-TYPE-LINE-MEDIUM "      (RACTION <>)">
  <ZORK-TYPE-LINE-MEDIUM "      (RDESC3 \"It is all a-muddle. A muddle. A mdl. MDL.\")">
  <ZORK-TYPE-LINE-MEDIUM "      (RVARS 0)">
  <ZORK-TYPE-LINE-MEDIUM "      (RVAL 0)>">
  <ZORK-TYPE-LINE-MEDIUM "">  
  <ZORK-PRINT-NOW "MDL> ">
  <ZORK-TYPE "VAXUM MDL" 100>
  <ZORK-TYPE-LINE-SLOWER "">
  <ZORK-TYPE-LINE-SLOWER "          ">
  <ZORK-TYPE-LINE-SLOWER "As you cast the spell, the gold lisp scroll vanishes!">
  <TERPRI>
  <ZORK-TYPE-LINE-SLOWER "The MDL smiles warmly and greets you as an old friend.">
  <ZORK-TYPE-LINE-SLOWER "">
  <ZORK-TYPE-LINE-SLOWER "          ">   
  <TERPRI>>

<ZORK-INTRO>
