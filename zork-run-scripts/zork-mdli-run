
#!/bin/sh
set -eu
umask 077

# Resolve the package root from:
# PACKAGE/libexec/confusion-mdl/zork-mdli-run
runner_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
prefix=$(CDPATH= cd -- "$runner_dir/../.." && pwd -P) || exit 1

mdli="$prefix/bin/mdli"
share="$prefix/share/confusion-mdl"

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
    printf '%s\n' \
        'Usage: zork-mdli-run VERSION DATE TITLE [--new-game]' >&2
    exit 2
fi

version=$1
game_date=$2
title=$3
new_game=no

if [ "$#" -eq 4 ]; then
    if [ "$4" != '--new-game' ]; then
        printf 'Unknown option: %s\n' "$4" >&2
        exit 2
    fi
    new_game=yes
fi

# Open the user's default terminal when launched without one.
if [ ! -t 0 ] || [ ! -t 1 ]; then
    if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
        printf '%s\n' \
            'No terminal is attached and xdg-terminal-exec is unavailable.' \
            'Run this launcher from a terminal or install xdg-terminal-exec.' >&2
        exit 1
    fi

    exec xdg-terminal-exec "--title=$title" -- sh "$0" "$@"
fi

# The early versions use an interpreter save image as their save slot.
# The later versions boot from MADADV.SAVE and use a separate game save.
case "$version" in
    771212|780124)
        seed_file='SAVEFILE/ZORK.SAVE'
        active_file='MTRZORK/ZORK.SAVE'
        save_mode='interpreter'
        ;;
    791211|810722)
        seed_file='MDL/MADADV.SAVE'
        active_file='MTRZORK/ZORK.SAVE'
        save_mode='game'
        ;;
    *)
        printf 'Unknown Zork version: %s\n' "$version" >&2
        exit 2
        ;;
esac

source="$share/mdlzork_$version/patched_confusion"
data="${XDG_DATA_HOME:-${HOME:?}/.local/share}/confusion-mdl"
game="$data/$version"

seed_save="$game/$seed_file"
active_save="$game/$active_file"

seed_name=${seed_file##*/}
save_name=${active_file##*/}
save_base=${save_name%.SAVE}

save_dir="$game/saves"
initial_dir="$save_dir/initial"
current_dir="$save_dir/current"
history_dir="$save_dir/history"

# Keep the initial interpreter image under its actual filename.
initial_save="$initial_dir/$seed_name"
current_save="$current_dir/$save_name"
link_target="../saves/current/$save_name"

if [ ! -x "$mdli" ]; then
    printf 'Interpreter not found or not executable: %s\n' "$mdli" >&2
    exit 1
fi

if [ ! -d "$source" ]; then
    printf 'Game data missing: %s\n' "$source" >&2
    exit 1
fi

mkdir -p "$game"

# Copy the packaged game into the user's writable directory once.
if [ ! -f "$game/run.mud" ]; then
    cp -R "$source/." "$game/" || {
        printf '%s\n' 'Could not install game files.' >&2
        exit 1
    }
fi

mkdir -p \
    "$initial_dir" \
    "$current_dir" \
    "$history_dir" \
    "$(dirname "$seed_save")" \
    "$(dirname "$active_save")"

# The game must be able to create and update its save file.
chmod u+rwx "$(dirname "$active_save")"

# Preserve the original interpreter image.
# Never substitute a game-level save for this image.
if [ ! -f "$initial_save" ]; then
    if [ ! -f "$seed_save" ]; then
        printf 'Initial interpreter image is missing: %s\n' \
            "$seed_save" >&2
        exit 1
    fi

    cp -p "$seed_save" "$initial_save"
fi

chmod a-w "$initial_save"

# Migrate an existing regular save from the old layout before replacing
# the game-facing path with the managed symlink.
if [ ! -f "$current_save" ] &&
   [ -f "$active_save" ] &&
   [ ! -L "$active_save" ]; then
    cp -p "$active_save" "$current_save"
fi

# Initialize interpreter-image saves from the initial image.
# Game-level saves must remain absent until the game creates one.
if [ "$save_mode" = interpreter ] && [ ! -f "$current_save" ]; then
    cp "$initial_save" "$current_save"
    chmod u+rw "$current_save"
fi

# Install the managed save link.
if [ -L "$active_save" ]; then
    existing_target=$(readlink "$active_save")
    if [ "$existing_target" != "$link_target" ]; then
        rm "$active_save"
        ln -s "$link_target" "$active_save"
    fi
elif [ -e "$active_save" ]; then
    # A regular file was migrated above if necessary.
    rm "$active_save"
    ln -s "$link_target" "$active_save"
else
    ln -s "$link_target" "$active_save"
fi

# New Game:
# - interpreter-save versions: restore the original interpreter image.
# - game-save versions: remove the runtime save so the game starts fresh.
if [ "$new_game" = yes ]; then
    if [ -f "$current_save" ]; then
        stamp=$(date '+%Y%m%d-%H%M%S')
        archive="$history_dir/$save_base-new-game-$stamp-$$.SAVE"

        cp -p "$current_save" "$archive"
        printf 'Previous save archived: %s\n' "$archive"
    fi

    if [ "$save_mode" = interpreter ]; then
        temporary="$current_dir/.$save_name.new-$$"
        trap 'rm -f "$temporary"' 0 HUP INT TERM

        cp "$initial_save" "$temporary"
        chmod u+rw "$temporary"
        mv -f "$temporary" "$current_save"

        trap - 0 HUP INT TERM
    else
        rm -f "$current_save"
    fi
fi

# Continue on early versions requires the current interpreter image.
if [ "$save_mode" = interpreter ] && [ ! -f "$current_save" ]; then
    cp "$initial_save" "$current_save"
    chmod u+rw "$current_save"
fi

cd "$game"
export CONFUSION_ZORK_DATE="$game_date"

# For 1979/1981, the interpreter boots from MADADV.SAVE.
# Continue then requires the game's own RESTORE command.
if [ "$save_mode" = game ] && [ "$new_game" = no ]; then
    if [ -f "$current_save" ]; then
        printf '\n%s\n' \
            'After the game starts, restore your saved progress with:' \
            '<RESTORE "ZORK.SAVE">'
    else
        printf '\n%s\n' \
            'No game save exists yet; starting a new game.'
    fi
fi

# Snapshot an existing runtime save before the session.
snapshot=''
if [ -f "$current_save" ]; then
    snapshot=$(mktemp "$history_dir/.snapshot.XXXXXX")
    cp -p "$current_save" "$snapshot"
fi

cleanup()
{
    if [ -n "$snapshot" ]; then
        rm -f "$snapshot"
    fi
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Start the appropriate interpreter image.
status=0

if [ "$save_mode" = interpreter ]; then
    "$mdli" -r "$active_file" || status=$?
else
    "$mdli" -r "$seed_file" || status=$?
fi

# Archive the previous save if the session changed or removed it.
if [ -n "$snapshot" ]; then
    if [ ! -f "$current_save" ] || ! cmp -s "$snapshot" "$current_save"; then
        stamp=$(date '+%Y%m%d-%H%M%S')
        archive="$history_dir/$save_base-$stamp-$$.SAVE"

        mv "$snapshot" "$archive"
        snapshot=''
        printf 'Previous save archived: %s\n' "$archive"
    fi
fi

exit "$status"
