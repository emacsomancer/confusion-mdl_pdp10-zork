
#!/bin/sh
set -eu
umask 077

# Resolve the package root from:
# PACKAGE/libexec/confusion-mdl/zork-mdli-run
runner_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
prefix=$(CDPATH= cd -- "$runner_dir/../.." && pwd -P) || exit 1

mdli="$prefix/bin/mdli"
expect="$runner_dir/expect"
share="$prefix/share/confusion-mdl"

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
    printf '%s\n' \
        'Usage: zork-mdli-run VERSION DATE TITLE [--new-game]' >&2
    exit 2
fi

version=$1
game_date=$2
title=$3
new_game=no

if [ "$#" -eq 4 ]; then
    if [ "$4" != '--new-game' ]; then
        printf 'Unknown option: %s\n' "$4" >&2
        exit 2
    fi
    new_game=yes
fi

# Open the user's default terminal when launched without one.
if [ ! -t 0 ] || [ ! -t 1 ]; then
    if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
        printf '%s\n' \
            'No terminal is attached and xdg-terminal-exec is unavailable.' \
            'Run this launcher from a terminal or install xdg-terminal-exec.' >&2
        exit 1
    fi

    exec xdg-terminal-exec "--title=$title" -- sh "$0" "$@"
fi

# The first two versions use complete Confusion interpreter images.
# The later versions use MADADV.SAVE to boot and a separate game save.
case "$version" in
    771212|780124)
        seed_file='SAVEFILE/ZORK.SAVE'
        active_file='MTRZORK/ZORK.SAVE'
        save_mode=interpreter
        ;;
    791211|810722)
        seed_file='MDL/MADADV.SAVE'
        active_file='MTRZORK/ZORK.SAVE'
        save_mode=game
        ;;
    *)
        printf 'Unknown Zork version: %s\n' "$version" >&2
        exit 2
        ;;
esac

source="$share/mdlzork_$version/patched_confusion"
data="${XDG_DATA_HOME:-${HOME:?}/.local/share}/confusion-mdl"
game="$data/$version"

seed_save="$game/$seed_file"
active_save="$game/$active_file"

seed_name=${seed_file##*/}
save_name=${active_file##*/}
save_base=${save_name%.SAVE}

save_dir="$game/saves"
initial_dir="$save_dir/initial"
current_dir="$save_dir/current"
history_dir="$save_dir/history"

initial_save="$initial_dir/$seed_name"
current_save="$current_dir/$save_name"
link_target="../saves/current/$save_name"

if [ ! -x "$mdli" ]; then
    printf 'Interpreter not found or not executable: %s\n' "$mdli" >&2
    exit 1
fi

if [ ! -d "$source" ]; then
    printf 'Game data missing: %s\n' "$source" >&2
    exit 1
fi

# Copy the packaged game into the user's writable directory once.
mkdir -p "$game"
chmod u+rwx "$game"

if [ ! -f "$game/run.mud" ]; then
    cp -R "$source/." "$game/" || {
        printf '%s\n' 'Could not install game files.' >&2
        exit 1
    }
fi

mkdir -p \
    "$initial_dir" \
    "$current_dir" \
    "$history_dir" \
    "$(dirname "$seed_save")" \
    "$(dirname "$active_save")"

chmod u+rwx \
    "$initial_dir" \
    "$current_dir" \
    "$history_dir" \
    "$(dirname "$active_save")"

# Preserve the original interpreter image.
# Never use a game-level save as a substitute for this image.
if [ ! -f "$initial_save" ]; then
    if [ ! -f "$seed_save" ]; then
        printf 'Initial interpreter image is missing: %s\n' \
            "$seed_save" >&2
        exit 1
    fi

    cp -p "$seed_save" "$initial_save" || exit 1
fi

chmod a-w "$initial_save"

# Keep the working copy of the original seed read-only.
if [ "$seed_save" != "$active_save" ] && [ -f "$seed_save" ]; then
    chmod a-w "$seed_save"
fi

# Migrate an existing regular save or an old save symlink.
# -f follows symlinks, so an existing save is preserved.
if [ ! -f "$current_save" ] && [ -f "$active_save" ]; then
    cp -p "$active_save" "$current_save" || exit 1
fi

# Only interpreter-image versions get initialized from the seed.
# The 1979/1981 game save must remain absent until the game creates it.
if [ "$save_mode" = interpreter ] && [ ! -f "$current_save" ]; then
    cp "$initial_save" "$current_save" || exit 1
fi

if [ -f "$current_save" ]; then
    chmod u+rw "$current_save"
fi

# Preserve a mismatched old save before replacing its path.
if [ -L "$active_save" ]; then
    old_target=$(readlink "$active_save")

    if [ "$old_target" != "$link_target" ]; then
        if [ -f "$active_save" ] &&
           [ -f "$current_save" ] &&
           ! cmp -s "$active_save" "$current_save"; then
            stamp=$(date '+%Y%m%d-%H%M%S')
            archive="$history_dir/$save_base-migration-$stamp-$$.SAVE"
            cp -p "$active_save" "$archive" || exit 1
        fi

        rm -f "$active_save"
        ln -s "$link_target" "$active_save"
    fi
elif [ -e "$active_save" ]; then
    if [ -f "$current_save" ] &&
       ! cmp -s "$active_save" "$current_save"; then
        stamp=$(date '+%Y%m%d-%H%M%S')
        archive="$history_dir/$save_base-migration-$stamp-$$.SAVE"
        cp -p "$active_save" "$archive" || exit 1
    fi

    rm -f "$active_save"
    ln -s "$link_target" "$active_save"
else
    ln -s "$link_target" "$active_save"
fi

# Start a new game.
if [ "$new_game" = yes ]; then
    if [ -f "$current_save" ]; then
        stamp=$(date '+%Y%m%d-%H%M%S')
        archive="$history_dir/$save_base-new-game-$stamp-$$.SAVE"

        cp -p "$current_save" "$archive" || exit 1
        printf 'Previous save archived: %s\n' "$archive"
    fi

    if [ "$save_mode" = interpreter ]; then
        temporary="$current_dir/.$save_name.new-$$"
        trap 'rm -f "$temporary"' 0 HUP INT TERM

        cp "$initial_save" "$temporary" || exit 1
        chmod u+rw "$temporary"
        mv -f "$temporary" "$current_save" || exit 1

        trap - 0 HUP INT TERM
    else
        # Leave the game save slot absent. The game starts fresh.
        rm -f "$current_save"
    fi
fi

# Ensure an interpreter-image save exists for the early versions.
if [ "$save_mode" = interpreter ] && [ ! -f "$current_save" ]; then
    cp "$initial_save" "$current_save" || exit 1
    chmod u+rw "$current_save"
fi

# Select the correct image to boot.
if [ "$save_mode" = interpreter ]; then
    boot_file=$active_file
else
    boot_file=$seed_file
fi

cd "$game"
export CONFUSION_ZORK_DATE="$game_date"

# Snapshot an existing save before the session.
snapshot=''

cleanup()
{
    if [ -n "$snapshot" ]; then
        rm -f "$snapshot"
    fi
}

trap cleanup 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -f "$current_save" ]; then
    snapshot=$(mktemp "$history_dir/.snapshot.XXXXXX") || exit 1
    cp -p "$current_save" "$snapshot" || exit 1
fi

status=0

if [ "$save_mode" = game ] &&
   [ "$new_game" = no ] &&
   [ -f "$current_save" ]; then

    # Confusion -r restores the interpreter image, not the game state.
    # Boot MADADV.SAVE, then invoke the game's registered restore command.
    if [ ! -x "$expect" ]; then
        printf 'Expect executable missing: %s\n' "$expect" >&2
        exit 1
    fi

    if "$expect" -c '
        set timeout 60

        set mdli [lindex $argv 0]
        set image [lindex $argv 1]

        spawn -noecho $mdli -r $image

        expect {
            -re {> $} {}
            timeout {
                send_user "\nTimed out waiting for the Zork prompt.\n"
                catch {close}
                catch {wait}
                exit 124
            }
            eof {
                send_user "\nConfusion exited before the Zork prompt.\n"
                exit 1
            }
        }

        send -- "restore\r"

        expect {
            -re {Restored\.} {}
            -re {Restore failed\.} {
                send_user "\nZork could not restore its game save.\n"
                catch {close}
                catch {wait}
                exit 1
            }
            timeout {
                send_user "\nTimed out waiting for Zork to restore its save.\n"
                catch {close}
                catch {wait}
                exit 124
            }
            eof {
                send_user "\nConfusion exited during game restore.\n"
                exit 1
            }
        }

        set timeout -1
        expect -re {> $}

        interact

        set result [wait]
        exit [lindex $result 3]
    ' "$mdli" "$boot_file"; then
        status=0
    else
        status=$?
    fi
else
    # 1977/1978: restore the complete interpreter image.
    # 1979/1981 New Game or first launch: boot the original image.
    "$mdli" -r "$boot_file" || status=$?
fi

# Archive the previous save if the session changed it.
if [ -n "$snapshot" ]; then
    if [ ! -f "$current_save" ] ||
       ! cmp -s "$snapshot" "$current_save"; then
        stamp=$(date '+%Y%m%d-%H%M%S')
        archive="$history_dir/$save_base-$stamp-$$.SAVE"

        mv "$snapshot" "$archive" || exit 1
        snapshot=''
        printf 'Previous save archived: %s\n' "$archive"
    else
        rm -f "$snapshot"
        snapshot=''
    fi
fi

exit "$status"
