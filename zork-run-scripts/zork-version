#!/bin/sh
set -eu

case "${0##*/}" in
    zork-1977)
        set -- 771212 'Dec 12 1977' 'Zork (1977-12-12)'
        ;;
    zork-1978)
        set -- 780124 'Jan 24 1978' 'Zork (1978-01-24)'
        ;;
    zork-1979)
        set -- 791211 'Dec 11 1979' 'Zork (1979-12-11)'
        ;;
    zork-1981)
        set -- 810722 'Jul 22 1981' 'Zork (1981-07-22)'
        ;;
    *)
        printf '%s\n' 'Unknown Zork launcher.' >&2
        exit 1
        ;;
esac

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
runner="$bin_dir/../libexec/confusion-mdl/zork-mdli-run"

exec "$runner" "$@"
