#!/bin/sh
set -eu

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
prefix=$(CDPATH= cd -- "$bin_dir/.." && pwd -P)

mdli="$prefix/bin/mdli"
share="$prefix/share/confusion-mdl"

if [ ! -t 0 ] || [ ! -t 1 ]; then
    if ! command -v xdg-terminal-exec >/dev/null 2>&1; then
        printf '%s\n' \
            'No terminal is attached and xdg-terminal-exec is unavailable.' \
            'Run this launcher from a terminal or install xdg-terminal-exec.' >&2
        exit 1
    fi

    exec xdg-terminal-exec \
        --title='Confusion MDL — Zork' \
        -- "$0" "$@"
fi

if [ ! -x "$mdli" ]; then
    printf 'Interpreter not found: %s\n' "$mdli" >&2
    exit 1
fi

export CONFUSION_MDL_PREFIX="$prefix"
export CONFUSION_MDL_SHARE="$share"
export CONFUSION_MDL_MDLI="$mdli"
export CONFUSION_MDL_EXPECT="$prefix/libexec/confusion-mdl/expect"
export CONFUSION_MDL_DATA_ROOT="${XDG_DATA_HOME:-${HOME:?}/.local/share}/confusion-mdl"
export CONFUSION_MDL_TIMESTAMP
CONFUSION_MDL_TIMESTAMP=$(date '+%Y%m%d-%H%M%S')

exec "$mdli" -f "$share/zorkmenu.mud"